# =====================================================================
# Variables de entorno — Sistema de Reservas IUC
#
# Copia este archivo como .env y reemplaza los valores ficticios.
#   cp .env.example .env
#
# En Vercel: Project Settings → Environment Variables (mismos nombres).
# NUNCA subas .env al repositorio.
# =====================================================================

# --- Supabase (públicas, seguras en el navegador) --------------------
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.VALOR_FICTICIO_DE_EJEMPLO.no_real

# =====================================================================
# SECRETOS — NO llevar al frontend, NO usar el prefijo VITE_
# Se configuran solo en el servidor:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   Vercel → Environment Variables (sin prefijo VITE_), solo si se usa
#   un proxy propio.
# =====================================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJ...CLAVE_PRIVADA...NO_EXPONER

# =====================================================================
# OPCIONAL — proxy propio para crear cuentas (Vercel Serverless Function)
# Si no se usa la Edge Function de Supabase.
# =====================================================================
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=eyJ...ANON...FICTICIO
